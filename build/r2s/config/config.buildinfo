CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y
# ---------------- 分区设置 ----------------
CONFIG_TARGET_KERNEL_PARTSIZE=18
CONFIG_TARGET_ROOTFS_PARTSIZE=656
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# ---------------- 编译环境 ----------------
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_IMAGEOPT is not set
# CONFIG_MAKE_TOOLCHAIN is not set
# CONFIG_SDK is not set
# CONFIG_HAS_TESTING_KERNEL is not set
# ---------------- 基础系统组件 ----------------
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_ipv6helper=m
# ---------------- LED模块(内置固件，开机直接可用) ----------------
CONFIG_PACKAGE_kmod-input-leds=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-leds-pca963x=y
CONFIG_PACKAGE_kmod-leds-uleds=y
CONFIG_PACKAGE_kmod-ledtrig-activity=y
CONFIG_PACKAGE_kmod-ledtrig-audio=y
CONFIG_PACKAGE_kmod-ledtrig-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-oneshot=y
CONFIG_PACKAGE_kmod-ledtrig-transient=y
# ---------------- I2C / OLED内核支持：kmod‑i2c‑core=y内置固件；工具库=m编译apk，用户按需安装 ----------------
CONFIG_PACKAGE_kmod-i2c-core=y
CONFIG_PACKAGE_i2c-tools=m
CONFIG_PACKAGE_libi2c=m
# ---------------- 文件系统驱动(内置固件) ----------------
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_kmod-fs-nfs-common=y
CONFIG_PACKAGE_kmod-fs-nfs-common-rpcsec=y
CONFIG_PACKAGE_kmod-fs-nfs-v3=y
CONFIG_PACKAGE_kmod-fs-nfs-v4=y
CONFIG_PACKAGE_kmod-fs-nfsd=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
# ---------------- USB核心驱动(内置固件) ----------------
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-dwc2=y
# ---------------- USB网络网卡驱动【=m编译输出apk包，固件不预装，按需安装】 ----------------
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
# CONFIG_PACKAGE_kmod-usb-net-cdc-eem is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ether is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-mbim is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ncm is not set
