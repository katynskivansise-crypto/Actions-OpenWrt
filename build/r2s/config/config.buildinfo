# netdata守护进程【=m编译输出apk包，固件不预装】
CONFIG_PACKAGE_netdata=m
# ---------------- WireGuard【=m编译输出apk包，固件不预装，用户apk add按需手动安装】 ----------------
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_wireguard-tools=m
