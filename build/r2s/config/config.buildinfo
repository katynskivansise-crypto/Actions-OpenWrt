CONFIG_PACKAGE_kmod-p54-usb=y
CONFIG_PACKAGE_kmod-zd1211rw=y
# ---------------- Realtek网卡驱动【=m编译输出apk包，固件不预装，按需安装】 ----------------
CONFIG_PACKAGE_kmod-rtl8187=y
